{
  "name": "port",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "jest --config ./jest.config.js",
    "lint": "ng lint",
    "lint:all": "npm run lint:scss && npm run lint",
    "lint:scss": "stylelint src/**/*.scss",
    "prettier:fix": "npm run prettier:fix:ts && npm run prettier:fix:scss && npm run prettier:fix:html",
    "prettier:fix:ts": "prettier --config \".prettierrc.json\" --write \"src/**/*.ts\"",
    "prettier:fix:scss": "prettier --config \".prettierrc.json\" --write \"src/**/*.scss\"",
    "prettier:fix:html": "prettier --config \".prettierrc.json\" --write \"src/**/*.html\"",
    "bundle-report": "ng build --stats-json && webpack-bundle-analyzer dist/portfolio/stats.json",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "prepare": "husky install",
    "release": "standard-version",
    "release:patch": "npm run release -- --release-as patch",
    "release:minor": "npm run release -- --release-as minor",
    "release:major": "npm run release -- --release-as major",
    "postinstall": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && typecheck && lint:all"
    }
  },
  "lint-staged": {
    "*.{js,ts,html,md,scss,json}": [
      "prettier --write",
      "git add"
    ]
  },
  "private": true,
  "engines": {
    "node": "^20.0.0"
  },
  "dependencies": {
    "@angular/animations": "^18.2.12",
    "@angular/cdk": "^18.2.13",
    "@angular/common": "^18.2.12",
    "@angular/compiler": "^18.2.12",
    "@angular/core": "^18.2.12",
    "@angular/forms": "^18.2.12",
    "@angular/material": "^18.2.13",
    "@angular/platform-browser": "^18.2.12",
    "@angular/platform-browser-dynamic": "^18.2.12",
    "@angular/router": "^18.2.12",
    "@ng-web-apis/common": "^3.2.3",
    "@ngneat/until-destroy": "^10.0.0",
    "lodash-es": "^4.17.21",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^18.4.0",
    "@angular-eslint/eslint-plugin": "^18.4.0",
    "@angular-eslint/eslint-plugin-template": "^18.4.0",
    "@angular-eslint/schematics": "^18.4.0",
    "@angular-eslint/template-parser": "^18.4.0",
    "@angular/build": "^18.2.12",
    "@angular/cli": "^18.2.12",
    "@angular/compiler-cli": "^18.2.12",
    "@ngneat/spectator": "^19.0.0",
    "@types/jest": "^29.5.14",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.17.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.13.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-rxjs": "^5.0.3",
    "eslint-plugin-rxjs-angular": "^2.0.1",
    "eslint-plugin-sonar": "^0.14.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-jasmine2": "^29.7.0",
    "jest-preset-angular": "^14.3.0",
    "ng-mocks": "^14.13.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "pretty-quick": "^4.0.0",
    "standard-version": "^9.5.0",
    "stylelint": "^16.10.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-prettier": "^5.0.2",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.4.5",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
