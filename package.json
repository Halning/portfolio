{
  "name": "port",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:app": "ng build",
    "build:lib": "ng build hal-utils",
    "watch": "ng build hal-utils --watch --configuration development",
    "watch:lib": "ng build --watch --configuration development",
    "test": "npm run test:lib && npm run build:lib && npm run test:app",
    "test:lib": "jest --config ./jest.lib.config.js",
    "test:app": "jest --config ./jest.app.config.js",
    "lint": "ng lint",
    "lint:all": "npm run lint:scss && npm run lint",
    "lint:scss": "stylelint src/**/*.scss",
    "prettier:fix": "npm run prettier:fix:ts && npm run prettier:fix:scss && npm run prettier:fix:html",
    "prettier:fix:ts": "prettier --config \".prettierrc.json\" --write \"src/**/*.ts\"",
    "prettier:fix:scss": "prettier --config \".prettierrc.json\" --write \"src/**/*.scss\"",
    "prettier:fix:html": "prettier --config \".prettierrc.json\" --write \"src/**/*.html\"",
    "bundle-report": "ng build --stats-json && webpack-bundle-analyzer dist/portfolio/stats.json",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "prepare": "husky install",
    "release": "standard-version",
    "release:patch": "npm run release -- --release-as patch",
    "release:minor": "npm run release -- --release-as minor",
    "release:major": "npm run release -- --release-as major",
    "postinstall": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && typecheck && lint:all"
    }
  },
  "lint-staged": {
    "*.{js,ts,html,md,scss,json}": [
      "prettier --write",
      "git add"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.1.1",
    "@angular/cdk": "^18.0.0",
    "@angular/common": "^18.1.1",
    "@angular/compiler": "^18.1.1",
    "@angular/core": "^18.1.1",
    "@angular/forms": "^18.1.1",
    "@angular/material": "^18.0.0",
    "@angular/platform-browser": "^18.1.1",
    "@angular/platform-browser-dynamic": "^18.1.1",
    "@angular/router": "^18.1.1",
    "@ng-web-apis/common": "^3.0.6",
    "@ngneat/until-destroy": "^10.0.0",
    "lodash-es": "^4.17.21",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.6"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.1.1",
    "@angular-eslint/builder": "^17.5.1",
    "@angular-eslint/eslint-plugin": "^17.5.1",
    "@angular-eslint/eslint-plugin-template": "^17.5.1",
    "@angular-eslint/schematics": "^17.5.1",
    "@angular-eslint/template-parser": "^17.5.1",
    "@angular/cli": "^18.1.1",
    "@angular/compiler-cli": "^18.1.1",
    "@briebug/cypress-schematic": "^5.0.0",
    "@ngneat/spectator": "^7.1.0",
    "@types/jest": "^26.0.23",
    "@types/lodash-es": "^4.17.4",
    "@types/node": "^12.11.1",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.1",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0 ",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-rxjs": "^5.0.3",
    "eslint-plugin-rxjs-angular": "^2.0.1",
    "eslint-plugin-sonar": "^0.14.1",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-jasmine2": "^27.0.4",
    "jest-preset-angular": "^9.0.3",
    "ng-mocks": "^12.1.0",
    "ng-packagr": "^18.0.0",
    "ng-samurai": "^3.0.0",
    "postcss": "^8.4.4",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "pretty-quick": "^4.0.0",
    "standard-version": "^9.3.2",
    "stylelint": "^14.2.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-standard-scss": "^3.0.0",
    "stylelint-prettier": "^5.0.0",
    "tailwindcss": "^2.2.19",
    "typescript": "~5.4.5",
    "webpack-bundle-analyzer": "^4.4.2"
  }
}
